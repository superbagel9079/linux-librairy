#!/bin/sh

# Read-only surface inventory for a hardened Debian host.
# Run as root: sudo surface-audit
# Nothing is modified; read the output and decide what to disable or remove.

echo "== listening sockets =="
ss -tulpn

echo
echo "== enabled services =="
systemctl list-unit-files --state=enabled

echo
echo "== setuid and setgid binaries =="
find / -xdev \( -perm -4000 -o -perm -2000 \) -type f -print 2>/dev/null

echo
echo "== installed packages =="
dpkg-query -f '${binary:Package}\n' -W | wc -l
