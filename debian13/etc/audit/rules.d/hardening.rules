#
# Audit rules for Debian 13.
# Drop-in: /etc/audit/rules.d is merged by augenrules into /etc/audit/audit.rules, so that generated file stays generated.
# augenrules and auditctl live in /usr/sbin, absent from a normal user PATH, so call them with sudo.
# Install: sudo apt install auditd
#          sudo install -D -m 640 hardening.rules /etc/audit/rules.d/hardening.rules
# Apply:   sudo augenrules --check && sudo augenrules --load
#          sudo systemctl restart auditd
# Check:   sudo auditctl -l
#          sudo ausearch -k identity
#

# Identity and authentication
-a always,exit -F path=/etc/passwd -F perm=wa -F key=identity
-a always,exit -F path=/etc/group -F perm=wa -F key=identity
-a always,exit -F path=/etc/shadow -F perm=wa -F key=identity
-a always,exit -F path=/etc/gshadow -F perm=wa -F key=identity
-a always,exit -F path=/etc/security/opasswd -F perm=wa -F key=identity
-a always,exit -F path=/etc/nsswitch.conf -F perm=wa -F key=identity
-a always,exit -F path=/etc/pam.d -F perm=wa -F key=pam

# Privilege escalation
-a always,exit -F path=/etc/sudoers -F perm=wa -F key=sudoers
-a always,exit -F path=/etc/sudoers.d -F perm=wa -F key=sudoers
-a always,exit -F path=/etc/sudo.conf -F perm=wa -F key=sudoers

# SSH and firewall
-a always,exit -F path=/etc/ssh/sshd_config -F perm=wa -F key=sshd
-a always,exit -F path=/etc/ssh/sshd_config.d -F perm=wa -F key=sshd
-a always,exit -F path=/etc/nftables.conf -F perm=wa -F key=firewall

# Updates and systemd
-a always,exit -F path=/etc/apt -F perm=wa -F key=updates
-a always,exit -F path=/etc/systemd -F perm=wa -F key=systemd
-a always,exit -F path=/etc/localtime -F perm=wa -F key=time

# Kernel modules and time changes
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -k modules
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time
-a always,exit -F arch=b32 -S adjtimex,settimeofday,clock_settime -k time

# Mounts
-a always,exit -F arch=b64 -S mount -k mounts
-a always,exit -F arch=b32 -S mount -k mounts

# Make the rules immutable until reboot. Uncomment once verified.
#-e 2
