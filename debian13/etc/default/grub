#
# Kernel command line hardening for Debian 13.
# This is /etc/default/grub itself; only GRUB_CMDLINE_LINUX_DEFAULT changes, the rest of the package default stays untouched.
# update-grub lives in /usr/sbin, absent from a normal user PATH, so call it with sudo.
# Install: sudo install -m 644 grub /etc/default/grub
# Apply:   sudo update-grub && sudo reboot
# Check:   cat /proc/cmdline
#
# If you change this file, run 'update-grub' afterwards to update
# /boot/grub/grub.cfg.
# For full documentation of the options in this file, see:
# info -f grub -n 'Simple configuration'
#

GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR=lsb_release -i -s 2> /dev/null || echo Debian
GRUB_CMDLINE_LINUX_DEFAULT="quiet init_on_alloc=1 init_on_free=1 slab_nomerge page_alloc.shuffle=1 randomize_kstack_offset=1 vsyscall=none"
GRUB_CMDLINE_LINUX=""
