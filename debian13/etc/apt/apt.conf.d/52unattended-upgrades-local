//
// Automatic security updates for Debian 13.
// Drop-in: 20auto-upgrades (enable) and 50unattended-upgrades (defaults) stay
// untouched; APT reads this directory in order and the last value wins.
// The file name must not contain a dot, or APT ignores it.
// Install: sudo install -m 644 52unattended-upgrades-local /etc/apt/apt.conf.d/52unattended-upgrades-local
// Apply:   none, APT reads this file on every run.
// Check:   sudo apt-config dump | grep -i unattended
//          sudo unattended-upgrade --dry-run --debug
//

// Reboot automatically so kernel and glibc updates take effect.
Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-WithUsers "true";
Unattended-Upgrade::Automatic-Reboot-Time "03:00";

// Clean up obsolete kernel packages and dangling dependencies.
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";

// Keep the update log in the journal too.
Unattended-Upgrade::SyslogEnable "true";
Unattended-Upgrade::SyslogFacility "daemon";

// Mail on every run. Needs a local MTA (none by default on Debian).
//Unattended-Upgrade::Mail "root";
//Unattended-Upgrade::MailReport "on-change";
