#
# This file is part of systemd.
#
# Hardening for the /tmp mount.
# Drop-in: a file in /etc/systemd/system shadows /lib/systemd/system/tmp.mount,
# so the vendor unit stays untouched.
# Install: sudo install -m 644 tmp.mount /etc/systemd/system/tmp.mount
# Apply:   sudo systemctl daemon-reload && sudo systemctl restart tmp.mount
# Check:   findmnt /tmp
#

[Unit]
Description=Temporary Directory /tmp
Documentation=https://systemd.io/TEMPORARY_DIRECTORIES
Documentation=man:file-hierarchy(7)
Documentation=https://systemd.io/API_FILE_SYSTEMS
ConditionPathIsSymbolicLink=!/tmp
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target umount.target
After=swap.target

[Mount]
What=tmpfs
Where=/tmp
Type=tmpfs
Options=mode=1777,strictatime,nosuid,nodev,noexec,size=50%%,nr_inodes=1m
